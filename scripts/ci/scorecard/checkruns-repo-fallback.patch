+func TestCheckRunsIPPolicyFallback(t *testing.T) {
+	for _, tc := range []struct {
+		name       string
+		graphError string
+		restStatus int
+		wantError  bool
+		wantREST   bool
+	}{
+		{"restricted prefetch", "the unrelated organization has an IP allow list enabled, and your IP address is not permitted to access this resource", 200, false, true},
+		{"restricted REST", "the unrelated organization has an IP allow list enabled, and your IP address is not permitted to access this resource", 403, true, true},
+		{"other failure", "upstream unavailable", 200, true, false},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			restCalls := 0
+			server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				w.Header().Set("Content-Type", "application/json")
+				if r.URL.Path == "/graphql" {
+					fmt.Fprintf(w, `{"errors":[{"message":%q}]}`, tc.graphError)
+					return
+				}
+				restCalls++
+				if r.URL.Path != "/repos/local/project/commits/main/check-runs" {
+					t.Errorf("unexpected API path: %s", r.URL.Path)
+				}
+				w.WriteHeader(tc.restStatus)
+				if tc.restStatus != 200 {
+					fmt.Fprint(w, `{"message":"forbidden"}`)
+					return
+				}
+				fmt.Fprint(w, `{"total_count":1,"check_runs":[{"status":"completed","conclusion":"success","app":{"slug":"local-ci"}}]}`)
+			}))
+			defer server.Close()
+			client := github.NewClient(server.Client())
+			client.BaseURL, _ = url.Parse(server.URL + "/")
+			handler := &checkrunsHandler{client: client, graphClient: githubv4.NewEnterpriseClient(server.URL+"/graphql", server.Client())}
+			handler.init(t.Context(), &Repo{owner: "local", repo: "project", commitSHA: "main"}, 20)
+			runs, err := handler.listCheckRunsForRef("main")
+			if (err != nil) != tc.wantError {
+				t.Fatalf("error=%v wantError=%v", err, tc.wantError)
+			}
+			if (restCalls > 0) != tc.wantREST {
+				t.Fatalf("REST calls=%d", restCalls)
+			}
+			if !tc.wantError && (len(runs) != 1 || runs[0].App.Slug != "local-ci") {
+				t.Fatalf("unexpected results: %v", runs)
+			}
+		})
+	}
+}
